# ==============================================================================
# GLOBAL COMPATIBILITY MATRIX AGENT - CONFIGURATION ENVIRONNEMENT
# ==============================================================================

# Clé API Google Gemini (Requise pour générer de nouveaux sujets toutes les 6h)
# Modèle utilisé : gemini-2.5-flash (génération universelle 8 langues en 1 seul appel)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# ROUTEUR MONDIAL AMAZON PARTENAIRES (Multi-Store / OneLink)
# ------------------------------------------------------------------------------
# Tag principal de repli (utilisé par défaut si un tag pays spécifique n'est pas renseigné)
AMAZON_PARTNER_TAG=autocompat-21

# Tags facultatifs par pays (si vous possédez des comptes Amazon Partenaires dédiés par zone)
# Si laissés vides ou non définis, ils utiliseront automatiquement la valeur de AMAZON_PARTNER_TAG
AMAZON_TAG_US=autocompat-21
AMAZON_TAG_UK=autocompat-uk-21
AMAZON_TAG_DE=autocompat-de-21
AMAZON_TAG_ES=autocompat-es-21
AMAZON_TAG_IT=autocompat-it-21
AMAZON_TAG_CA=autocompat-ca-21
AMAZON_TAG_JP=autocompat-jp-21
AMAZON_TAG_AU=autocompat-au-21
AMAZON_TAG_NL=autocompat-nl-21
AMAZON_TAG_BR=autocompat-br-21

# ------------------------------------------------------------------------------
# DÉPLOIEMENT GITHUB PAGES & DIFFUSION IA
# ------------------------------------------------------------------------------
# URL racine publique de votre site GitHub Pages (sans slash terminal)
SITE_URL=https://alexandretouret.github.io/global-compatibility-matrix-agent
GITHUB_REPOSITORY=alexandretouret/global-compatibility-matrix-agent
